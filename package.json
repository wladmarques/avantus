{
  "name": "avantus-atendimento",
  "version": "1.0.0",
  "description": "Central de atendimento automatizada com fila por voz para o servidor FiveM VANTUS",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --trace-warnings index.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/check-syntax.js",
    "check:tracked": "node scripts/check-tracked.js",
    "package": "node scripts/package.js",
    "preview:panel": "node scripts/preview-panel.js",
    "preview:staff": "node scripts/preview-staff.js",
    "preview": "npm run preview:panel && npm run preview:staff"
  },
  "keywords": [
    "discord",
    "discord.js",
    "atendimento",
    "fila",
    "fivem",
    "vantus"
  ],
  "author": "VANTUS",
  "license": "UNLICENSED",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "sql.js": "^1.15.2"
  }
}
