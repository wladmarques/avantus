# ============================================================
# VANTUS Atendimento — variáveis de ambiente
# Copie para .env e preencha. NUNCA compartilhe o token.
# ============================================================

# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID do bot (Developer Portal > General Information)
# Usado para gerar o link de convite (npm run invite) e conferir se o token é do bot certo.
CLIENT_ID=1200967871480737912

# ID do servidor da VANTUS (clique com o botão direito no ícone do servidor > Copiar ID)
GUILD_ID=

# Caminho do banco SQLite (mantenha dentro da pasta da aplicação)
DB_PATH=./data/vantus.sqlite

# Fuso horário usado em horários, logs e relatórios
TIMEZONE=America/Sao_Paulo

# Registra automaticamente os slash commands ao iniciar
AUTO_REGISTER_COMMANDS=true

# (Opcional) ID de um servidor de testes para publicar os comandos
DEV_GUILD_ID=

# Intervalo padrão de atualização dos painéis (segundos)
PANEL_REFRESH_SECONDS=30

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# ============================================================
# Painel web do banco de horas
# Deixe WEB_PANEL_PASSWORD vazio para manter o painel desligado.
# ============================================================

# Senha do painel (obrigatória para habilitar)
WEB_PANEL_PASSWORD=

# Porta do painel. Na SquareCloud (app do tipo Site) use 80.
WEB_PANEL_PORT=8080

# Interface de escuta (0.0.0.0 aceita conexões externas)
WEB_PANEL_HOST=0.0.0.0

# ============================================================
# Deploy pela API da SquareCloud (opcional, NÃO vai para o app)
# Use apenas no seu terminal ou como secrets do GitHub Actions.
# ============================================================

# Token em squarecloud.app > Conta > Segurança (escopos apps:deploy e apps:control)
# SQUARECLOUD_TOKEN=
# ID da aplicação (aparece na URL do painel)
# SQUARECLOUD_APP_ID=
